{
  "name": "stockpilot",
  "version": "0.1.0",
  "private": true,
  "description": "StockPilot \u2014 internal warehouse + inventory operations platform (invite-only)",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\"",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "db:types": "supabase gen types typescript --linked > packages/core/src/types/database.ts",
    "db:types:local": "supabase gen types typescript --local > packages/core/src/types/database.ts",
    "db:types:remote": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > packages/core/src/types/database.ts",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:migrate": "supabase migration up",
    "db:test": "supabase test db",
    "security:test": "bash scripts/security-test.sh",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.102.0",
    "turbo": "^2.10.12",
    "typescript": "^5.6.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "sharp"
    ],
    "overrides": {
      "@types/react": "19.2.18",
      "@types/react-dom": "19.0.4",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "postcss@8": "^8.5.23",
      "fast-uri@3": "^3.1.5",
      "dompurify@3": "^3.4.13",
      "@xmldom/xmldom": "^0.8.14",
      "@babel/plugin-transform-modules-systemjs": "^7.29.4",
      "vite": "^6.4.3",
      "esbuild": "^0.25.0",
      "tmp": ">=0.2.6",
      "ws": ">=8.20.1",
      "shell-quote": ">=1.9.0",
      "qs": ">=6.15.2",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@2": "^2.1.4",
      "brace-expansion@5": "^5.0.9",
      "form-data@4": ">=4.0.6",
      "minimatch@5": ">=5.1.8",
      "node-forge": ">=1.4.0",
      "tar@7": ">=7.5.16",
      "undici@6": "^8.9.0",
      "undici@8": "^8.9.0",
      "ajv@8": ">=8.18.0",
      "joi@17": ">=17.13.4",
      "js-yaml@4": ">=4.2.0 <5",
      "ts-deepmerge": ">=8.0.0",
      "uuid": ">=11.1.1",
      "yaml@2": ">=2.8.3",
      "diff@7": "8.0.3",
      "@babel/core@7": ">=7.29.6 <8",
      "js-yaml@3": ">=3.15.0 <4",
      "js-yaml@5": ">=5.2.2"
    },
    "patchedDependencies": {
      "react-native-document-scanner-plugin@2.0.4": "patches/react-native-document-scanner-plugin@2.0.4.patch"
    }
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "arrowParens": "always",
    "endOfLine": "lf",
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "tailwindConfig": "./apps/web/tailwind.config.ts"
  }
}
