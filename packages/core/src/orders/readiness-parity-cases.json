{
  "about": [
    "ONE FIXTURE, TWO ENGINES (F2 plan 3.6). Each case is a small order and the stock around it.",
    "Core (readiness.parity.test.ts) derives the facts order_readiness_facts would return for it (scripts/gen-readiness-parity-sql.mjs caseFacts) and checks assessOrderReadiness, readinessStockFlags and projectCompletePicking against `expect`.",
    "pgTAP (supabase/tests/0377_order_readiness_facts.test.sql) builds the same rows, checks that the real facts function returns those facts, and runs the FROZEN RPCs (approve_order_request, approve_partial, resume_fulfillment, complete_picking) against `expect`, each call rolled back.",
    "After editing this file run: node scripts/gen-readiness-parity-sql.mjs (a vitest guard fails while the SQL block is stale).",
    "Holdings are [kind, warehouse, quantity]: kind rack | crate | site (NULL kind) | unplaced | staging; warehouse home (the order's) | other | org (no warehouse). On hand is the sum of the holdings unless `onHand` is given (records that disagree).",
    "Holds: own (this order), otherOrder (an approved order holding exactly what it owes, so it adds nothing to committedOtherShortfall), rental (no order).",
    "Duplicate-item lines are excluded from the completion parity claim (complete_picking reads on hand from its cursor; 0 duplicate lines in production), so no picking case has one."
  ],
  "cases": [
    {
      "id": "C1a",
      "title": "approve succeeds when every item has D <= A, with an other-order hold and a rental hold",
      "status": "pending_approval",
      "items": {
        "a": { "holdings": [["rack", "home", 10]], "holds": { "otherOrder": 3, "rental": 2 } },
        "b": { "holdings": [["rack", "home", 4], ["staging", "home", 2]] }
      },
      "lines": [
        { "id": "l1", "item": "a", "requested": 5 },
        { "id": "l2", "item": "b", "requested": 6 }
      ],
      "expect": {
        "lines": {
          "l1": { "state": "ready", "ready": 5 },
          "l2": { "state": "needs_put_away", "ready": 4, "putAway": 2 }
        },
        "flags": { "isShortStock": false },
        "approveSucceeds": true,
        "approvePartialHolds": { "a": 5, "b": 6 },
        "draftable": { "a": 0, "b": 0 }
      }
    },
    {
      "id": "C1b",
      "title": "approve refuses when one item has D > A: the rental hold counts against availability",
      "status": "pending_approval",
      "items": {
        "a": { "holdings": [["rack", "home", 10]], "holds": { "otherOrder": 3, "rental": 2 } }
      },
      "lines": [{ "id": "l1", "item": "a", "requested": 6 }],
      "expect": {
        "lines": { "l1": { "state": "short", "ready": 5, "short": 1 } },
        "flags": { "isShortStock": true },
        "approveSucceeds": false,
        "approveError": "insufficient_stock",
        "approvePartialHolds": { "a": 5 },
        "draftable": { "a": 1 }
      }
    },
    {
      "id": "C2",
      "title": "duplicate lines 3 + 3 against 5 on hand: approve refuses, approve_partial holds exactly 5, the units are allocated once",
      "status": "pending_approval",
      "items": { "a": { "holdings": [["rack", "home", 5]] } },
      "lines": [
        { "id": "l1", "item": "a", "requested": 3 },
        { "id": "l2", "item": "a", "requested": 3 }
      ],
      "expect": {
        "lines": {
          "l1": { "state": "ready", "ready": 3 },
          "l2": { "state": "short", "ready": 2, "short": 1 }
        },
        "flags": { "isShortStock": true },
        "approveSucceeds": false,
        "approveError": "insufficient_stock",
        "approvePartialHolds": { "a": 5 },
        "draftable": { "a": 1 }
      }
    },
    {
      "id": "C3",
      "title": "approved, own hold 10 of on hand 10: the own hold is supply, so the line is ready and held",
      "status": "approved",
      "items": { "a": { "holdings": [["rack", "home", 10]], "holds": { "own": 10 } } },
      "lines": [{ "id": "l1", "item": "a", "requested": 10 }],
      "expect": {
        "lines": { "l1": { "state": "ready", "ready": 10, "hold": "held" } },
        "draftable": { "a": 0 }
      }
    },
    {
      "id": "C4",
      "title": "backordered, owed 4 (6 requested, 2 handed over), 3 free: resume_fulfillment holds exactly 3",
      "status": "backordered",
      "items": { "a": { "holdings": [["rack", "home", 5]], "holds": { "otherOrder": 2 } } },
      "lines": [{ "id": "l1", "item": "a", "requested": 6, "fulfilled": 2 }],
      "expect": {
        "lines": { "l1": { "state": "short", "ready": 3, "short": 1 } },
        "flags": { "hasFulfillableStock": true },
        "resumeHolds": { "a": 3 },
        "draftable": { "a": 1 }
      }
    },
    {
      "id": "C4b",
