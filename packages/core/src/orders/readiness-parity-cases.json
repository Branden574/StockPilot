      "items": {
        "a": { "holdings": [["rack", "home", 10]], "holds": { "own": 6, "otherOrder": 4 } },
        "b": { "holdings": [["rack", "home", 3]], "holds": { "own": 3 } },
        "c": { "holdings": [["site", "home", 4], ["unplaced", "home", 2]], "holds": { "own": 5, "rental": 1 } },
        "d": { "holdings": [["rack", "home", 8]], "holds": { "own": 5, "otherOrder": 4 } }
      },
      "lines": [
        { "id": "l1", "item": "a", "requested": 6 },
        { "id": "l2", "item": "b", "requested": 5 },
        { "id": "l3", "item": "c", "requested": 5 },
        { "id": "l4", "item": "d", "requested": 5 }
      ],
      "expect": {
        "lines": {
          "l1": { "state": "ready", "ready": 6, "hold": "held" },
          "l2": { "state": "short", "ready": 3, "short": 2, "hold": "partly_held" },
          "l3": { "state": "ready", "ready": 5, "noRack": 5, "hold": "held" },
          "l4": { "state": "short", "ready": 4, "short": 1, "hold": "held" }
        },
        "projectedPicked": { "l1": 6, "l2": 3, "l3": 5, "l4": 4 },
        "completeFails": false,
        "draftable": { "a": 0, "b": 2, "c": 0, "d": 1 }
      }
    },
    {
      "id": "C6",
      "title": "rack 6 + Staging 4, own hold 10: needs put-away 4, and the one-click pick raises insufficient_placed_stock",
      "status": "pick_slip_generated",
      "items": { "a": { "holdings": [["rack", "home", 6], ["staging", "home", 4]], "holds": { "own": 10 } } },
      "lines": [{ "id": "l1", "item": "a", "requested": 10 }],
