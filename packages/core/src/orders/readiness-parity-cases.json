      "title": "another order holds 5 of rack 10, Staging 5: readiness says ready 5 plus put-away 5 (conservative) while the one-click pick succeeds",
      "status": "pick_slip_generated",
      "items": { "a": { "holdings": [["rack", "home", 10], ["staging", "home", 5]], "holds": { "own": 10, "otherOrder": 5 } } },
      "lines": [{ "id": "l1", "item": "a", "requested": 10 }],
      "expect": {
