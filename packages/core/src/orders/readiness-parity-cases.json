        "lines": { "l1": { "state": "unknown", "ready": 7, "gap": 3, "hold": "held" } },
        "completeFails": true,
        "completeError": "insufficient_placed_stock",
        "completeNeedPutAway": { "a": 0 },
        "completeUnaccounted": { "a": 3 },
        "draftable": { "a": 0 }
      }
    },
    {
      "id": "C6b",
      "title": "rack 6 + Unplaced 4, own hold 10: ready (4 with no rack recorded), and the one-click pick takes all 10",
      "status": "pick_slip_generated",
