{
  "name": "@stockpilot/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .expo node_modules",
    "release:ios": "pnpm exec eas build --platform ios --profile production --auto-submit --no-wait --non-interactive",
    "release:android": "pnpm exec eas build --platform android --profile production --auto-submit --no-wait --non-interactive"
  },
  "dependencies": {
    "@expo-google-fonts/instrument-serif": "^0.4.1",
