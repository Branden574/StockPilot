    "expo-system-ui": "~5.0.11",
    "expo-task-manager": "~13.1.6",
    "expo-updates": "~0.28.18",
    "lucide-react-native": "^1.18.0",
    "query-string": "7.1.3",
    "react": "19.2.7",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~3.19.5",
    "react-native-safe-area-context": "~5.8.0",
