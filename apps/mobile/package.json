{
  "name": "@stockpilot/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf .expo node_modules",
    "release:ios": "pnpm dlx eas-cli@20.3.0 build --platform ios --profile production --auto-submit --no-wait --non-interactive",
    "release:android": "pnpm dlx eas-cli@20.3.0 build --platform android --profile production --auto-submit --no-wait --non-interactive",
    "release:ota": "bash scripts/release-ota.sh",
    "submit:review": "node scripts/asc-submit-for-review.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/instrument-serif": "^0.4.1",
    "@expo-google-fonts/inter-tight": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/drawer": "^7.5.0",
    "@react-navigation/native": "^7.1.33",
    "@sentry/cli": "2.45.0",
    "@sentry/react-native": "~7.11.0",
    "@stockpilot/core": "workspace:*",
    "@supabase/supabase-js": "^2.46.1",
    "expo": "~55.0.28",
    "expo-blur": "~55.0.16",
    "expo-camera": "~55.0.21",
    "expo-constants": "~55.0.17",
    "expo-device": "~55.0.19",
    "expo-document-picker": "~55.0.15",
    "expo-file-system": "~55.0.24",
    "expo-image": "~55.0.11",
    "expo-image-manipulator": "^55.0.19",
    "expo-image-picker": "~55.0.22",
    "expo-linear-gradient": "~55.0.16",
    "expo-linking": "~55.0.16",
    "expo-local-authentication": "^55.0.16",
    "expo-network": "~55.0.16",
    "expo-notifications": "~55.0.25",
    "expo-print": "~55.0.17",
    "expo-router": "~55.0.17",
    "expo-secure-store": "~55.0.16",
    "expo-sqlite": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.20",
    "expo-updates": "~55.0.26",
    "lucide-react-native": "^1.16.0",
    "query-string": "7.1.3",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-document-scanner-plugin": "^2.0.4",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-reanimated": "~4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "eslint-config-expo": "~55.0.1",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
