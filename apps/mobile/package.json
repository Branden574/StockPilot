{
  "name": "@stockpilot/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf .expo node_modules",
    "release:ios": "pnpm dlx eas-cli@20.3.0 build --platform ios --profile production --auto-submit --no-wait --non-interactive",
    "release:android": "pnpm dlx eas-cli@20.3.0 build --platform android --profile production --auto-submit --no-wait --non-interactive",
    "release:ota": "bash scripts/release-ota.sh",
    "submit:review": "node scripts/asc-submit-for-review.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/instrument-serif": "^0.4.1",
    "@expo-google-fonts/inter-tight": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@sentry/cli": "2.45.0",
    "@sentry/react-native": "~7.11.0",
    "@stockpilot/core": "workspace:*",
    "@supabase/supabase-js": "^2.46.1",
    "expo": "~56.0.19",
    "expo-blur": "~56.0.4",
    "expo-camera": "~56.0.8",
    "expo-constants": "~56.0.23",
    "expo-device": "~56.0.4",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.9",
    "expo-image": "~56.0.11",
    "expo-image-manipulator": "^56.0.24",
    "expo-image-picker": "~56.0.23",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.16",
    "expo-local-authentication": "^56.0.5",
    "expo-network": "~56.0.5",
    "expo-notifications": "~56.0.23",
    "expo-print": "~56.0.4",
    "expo-router": "~56.2.18",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.14",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.24",
    "lucide-react-native": "^1.16.0",
    "query-string": "7.1.3",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-document-scanner-plugin": "^2.0.4",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-reanimated": "~4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "eslint-config-expo": "~56.0.4",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
