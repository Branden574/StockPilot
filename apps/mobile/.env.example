# Mobile-specific env. EXPO_PUBLIC_ vars are inlined at build time and
# accessible via process.env in client code. Same Supabase project as web.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# REST API base — typically your deployed web app's URL.
# For local dev with the simulator: http://localhost:3000
# For physical device: http://<your-mac-lan-ip>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
