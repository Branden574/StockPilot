{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "bash -c 'if [ \"${VERCEL_GIT_COMMIT_REF#dependabot/}\" != \"$VERCEL_GIT_COMMIT_REF\" ]; then exit 0; else exit 1; fi'",
  "crons": [
    {
      "path": "/api/cron/purge-ai-chat-history",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 14 * * 1"
    },
    {
      "path": "/api/cron/drain-outbox",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/reap-stuck-shipments",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/price-pull",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/auto-reorder",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/restore-points",
      "schedule": "0 2 * * *"
    }
  ],
  "functions": {
    "src/app/api/orders/**/route.tsx": {
      "memory": 1769,
      "maxDuration": 60
    },
    "src/app/api/purchase-orders/**/route.tsx": {
      "memory": 1769,
      "maxDuration": 60
    },
    "src/app/api/reports/**/route.tsx": {
      "memory": 1769,
      "maxDuration": 60
    },
    "src/app/api/cycle-counts/**/route.tsx": {
      "memory": 1769,
      "maxDuration": 60
    }
  }
}
