# ─── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=StockPilot

# ─── Supabase ─────────────────────────────────────────────────────────────
# Local: get from `supabase status` after `supabase start`
# Cloud: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose to the client. Used by edge functions / admin client.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe ───────────────────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Price IDs for each plan / interval (set after creating products in Stripe)
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_PRO_YEARLY=
NEXT_PUBLIC_STRIPE_PRICE_BUSINESS_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_BUSINESS_YEARLY=

# ─── Resend (transactional email) ─────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL="StockPilot <hello@stockpilot.app>"
RESEND_WEBHOOK_SECRET=

# ─── Observability ────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Rate limiting (optional, recommended for prod) ───────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
