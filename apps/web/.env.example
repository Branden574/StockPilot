# ─── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=StockPilot

# Optional: MapTiler key for the live delivery-tracking basemap. If unset, the
# map falls back to no-key OpenStreetMap raster tiles (works, lower rate limit).
# Free key (100k loads/mo, no card): https://cloud.maptiler.com/account/keys/
NEXT_PUBLIC_MAPTILER_KEY=

# ─── Supabase ─────────────────────────────────────────────────────────────
# Local: get from `supabase status` after `supabase start`
# Cloud: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose to the client. Used by edge functions / admin client.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe ───────────────────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Price IDs for each plan / interval (set after creating products in Stripe)
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_PRO_YEARLY=
NEXT_PUBLIC_STRIPE_PRICE_BUSINESS_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_BUSINESS_YEARLY=

# ─── Resend (transactional email) ─────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL="StockPilot <hello@stockpilot.app>"
RESEND_WEBHOOK_SECRET=

# ─── Observability ────────────────────────────────────────────────────────
# Generic error webhook. lib/error-reporter.ts POSTs a JSON payload here
# whenever it captures an error. Compatible with any custom endpoint or
# Slack incoming webhook (server-side reformat to Slack blocks). Leave
# blank to keep errors as console.error only.
ERROR_WEBHOOK_URL=

# Sentry (optional). Drop in @sentry/nextjs and these vars start working.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Gemini AI (free tier on Google AI Studio) ───────────────────────────
# Get a key from https://aistudio.google.com/app/apikey
# Powers /api/po-imports/scan (PO photo extraction) AND /api/ai/chat
# (the inventory assistant chatbot). The free tier covers 1500 reqs/day
# + 1M tokens/day, more than enough for a typical school-org volume.
GEMINI_API_KEY=

# Model override — defaults to gemini-2.5-flash (current production
# model). gemini-1.5-flash was retired by Google; gemini-2.0-flash
# shows 0 free quota on some accounts. Both PO scan + chat use this.
GEMINI_MODEL=gemini-2.5-flash

# ─── Rate limiting (optional, recommended for prod) ───────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
