# dependencies
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# testing
coverage/
.nyc_output/

# next.js
.next/
out/
build/
dist/

# production
*.tsbuildinfo
next-env.d.ts

# misc
.DS_Store
*.pem
.vscode/
.idea/
*.swp
*.swo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files — broadened after 2026-05-17 incident where
# apps/web/.env.local.prod (a backup of prod credentials) slipped
# through `.env*.local` because the filename ends in `.prod`, not
# `.local`. Match every plausible env-file shape regardless of
# suffix order. .env.example is allowed back via the negation below.
.env
.env.*
*.env
.env*
**/.env
**/.env.*
**/*.env
# Allow committed templates / sample files. NEVER add real secrets.
!.env.example
!**/.env.example

# personal secret notebooks — never commit
secrets.local.md
*.secrets.local
*.secrets.local.md

# vercel
.vercel

# turbo
.turbo

# supabase
**/supabase/.branches
**/supabase/.temp
**/supabase/.env

# logs
logs/
*.log

# typescript
*.tsbuildinfo

# Note: packages/core/src/types/database.ts is committed as a placeholder
# (currently `Database = any`). After running `pnpm db:types` you'll commit
# the real generated types over it.

# Playwright
playwright-report/
test-results/
**/tests/e2e/.auth/

# Load tests — local env + result artifacts
load-tests/.env.local.loadtest
load-tests/results/

# Expo prebuild output — apps/mobile/ios + apps/mobile/android are
# generated by `expo prebuild` from app.config.ts on every build, so
# committing them bloats the repo and creates merge conflicts. All
# native config lives in app.config.ts + Expo plugins instead.
apps/mobile/ios/
apps/mobile/android/

# Expo local cache + native build artifacts
**/.expo/
**/.expo-shared/

# Local agent / tool caches — never belong in git
.claude/
.firecrawl/
.playwright-mcp/

# pnpm sometimes drops a numbered lockfile copy when two `pnpm install`
# runs collide. Real lockfile is pnpm-lock.yaml; the "pnpm-lock 2.yaml"
# / "pnpm-lock 3.yaml" siblings are junk.
pnpm-lock\ *.yaml
"pnpm-lock 2.yaml"

# iCloud Drive / Finder duplicate-copy artifacts ("Name 2.ext", "Name 3.tsx", …)
# created when the synced working tree conflicts mid-write. These are never
# source — ignore them so they can't be `git add .`'d into a build break or
# pollute a duplicate migration. (Already-tracked files are unaffected.)
* [2-9].ts
* [2-9].tsx
* [2-9].js
* [2-9].jsx
* [2-9].mjs
* [2-9].cjs
* [2-9].sql
* [2-9].json

secrets/
